            </div>
        </div>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="py-20 px-6 bg-slate-950/60 border-y border-slate-800/50">
        <div class="max-w-6xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">Technical & Soft <span class="text-teal-400">Skills</span></h2>
                <div class="w-20 h-1 bg-gradient-to-r from-teal-500 to-amber-500 mx-auto rounded-full"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Programming Languages -->
                <div class="glass-card p-6 rounded-2xl border border-slate-800 hover:border-teal-500/40 transition-all hover:-translate-y-1">
