                <!-- Contact Form -->
                <div class="glass-card p-8 rounded-2xl border border-slate-800">
                    <form id="contactForm" class="space-y-4" onsubmit="event.preventDefault(); handleFormSubmit();">
                        <div>
                            <label class="block text-xs font-semibold uppercase text-slate-400 mb-2">Your Name</label>
