                <!-- Service 3 -->
                <div class="glass-card p-8 rounded-2xl border border-slate-800 hover:border-teal-500/50 transition-colors group">
                    <div class="w-14 h-14 bg-teal-500/10 rounded-2xl flex items-center justify-center text-teal-400 text-2xl mb-6 group-hover:scale-110 transition-transform">
