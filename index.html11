                <div class="w-20 h-1 bg-gradient-to-r from-teal-500 to-amber-500 mx-auto rounded-full"></div>
            </div>

            <div class="glass-card p-8 sm:p-10 rounded-2xl max-w-3xl mx-auto border border-slate-800 relative overflow-hidden">
                <div class="absolute top-0 right-0 w-32 h-32 bg-amber-500/10 rounded-bl-full pointer-events-none"></div>
                
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 pb-6 border-b border-slate-800">
                    <div>
                        <span class="inline-block px-3 py-1 bg-amber-500/20 text-amber-400 text-xs font-semibold rounded-full mb-2">2024 - 2028</span>
