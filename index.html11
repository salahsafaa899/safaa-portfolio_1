    <!-- Offered Services Section -->
    <section id="services" class="py-20 px-6">
        <div class="max-w-6xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">Offered <span class="text-teal-400">Services</span></h2>
                <div class="w-20 h-1 bg-gradient-to-r from-teal-500 to-amber-500 mx-auto rounded-full"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Service 1 -->
                <div class="glass-card p-8 rounded-2xl border border-slate-800 hover:border-teal-500/50 transition-colors group">
                    <div class="w-14 h-14 bg-teal-500/10 rounded-2xl flex items-center justify-center text-teal-400 text-2xl mb-6 group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-chart-bar"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-100 mb-3">Basic Data Analysis</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        Extracting actionable insights from data, cleaning messy records, and generating clear charts and dashboards.
                    </p>
