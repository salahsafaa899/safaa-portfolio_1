        <p>© 2026 Safaa Salaheldin. All rights reserved.</p>
    </footer>

    <script>
        // Interactive Mobile Navigation Drawer
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        
        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Interactive Photo Upload Logic (Instant Real-Time Browser Image Preview)
        const photoInput = document.getElementById('photoInput');
        const avatarContainer = document.getElementById('avatarContainer');
        const uploadBtn = document.getElementById('uploadBtn');
        
        const userAvatarImg = document.getElementById('userAvatarImg');
        const defaultAvatarSvg = document.getElementById('defaultAvatarSvg');
        const aboutAvatarImg = document.getElementById('aboutAvatarImg');
        const aboutDefaultAvatar = document.getElementById('aboutDefaultAvatar');

        function triggerUpload() {
            photoInput.click();
        }

        avatarContainer.addEventListener('click', triggerUpload);
        uploadBtn.addEventListener('click', triggerUpload);

        photoInput.addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    const imageDataUrl = event.target.result;
                    
                    // Display Hero image
                    userAvatarImg.src = imageDataUrl;
                    userAvatarImg.classList.remove('hidden');
                    defaultAvatarSvg.classList.add('hidden');

                    // Display About Me image
                    aboutAvatarImg.src = imageDataUrl;
                    aboutAvatarImg.classList.remove('hidden');
                    aboutDefaultAvatar.classList.add('hidden');
                };
                reader.readAsDataURL(file);
            }
        });

        // Contact Form Submission Handler
        function handleFormSubmit() {
            const feedback = document.getElementById('formFeedback');
            feedback.className = "mt-4 p-4 rounded-xl text-center text-xs sm:text-sm font-semibold bg-teal-500/20 text-teal-300 border border-teal-500/30";
            feedback.innerText = "Thank you! Your message has been submitted successfully.";
            feedback.classList.remove('hidden');
            document.getElementById('contactForm').reset();
            setTimeout(() => {
                feedback.classList.add('hidden');
            }, 5000);
        }
    </script>
</body>
</html>
