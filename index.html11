<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Safaa Salaheldin | AI & Data Science Portfolio</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        tealAccent: '#14b8a6',
                        tealDark: '#0f766e',
                        goldAccent: '#f59e0b',
                        amberDark: '#d97706',
                        bgDark: '#0b0f19',
                        cardDark: 'rgba(17, 24, 39, 0.75)'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <!-- FontAwesome Icons & Google Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Custom Modern Styles -->
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0b0f19;
            color: #f1f5f9;
        }

        .glass-card {
            background: rgba(17, 24, 39, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .text-gradient {
            background: linear-gradient(135deg, #2dd4bf 0%, #38bdf8 50%, #f59e0b 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .glow-effect {
            box-shadow: 0 0 35px -5px rgba(20, 184, 166, 0.3);
        }

        .photo-upload-hover:hover .upload-overlay {
            opacity: 1;
        }

        /* Smooth custom scrollbars */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0b0f19;
        }
        ::-webkit-scrollbar-thumb {
            background: #1e293b;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #14b8a6;
        }
    </style>
</head>
<body class="bg-[#0b0f19] text-slate-100 transition-colors duration-300 min-h-screen relative overflow-x-hidden">

    <!-- Navigation Bar -->
    <nav class="fixed top-0 left-0 w-full z-50 glass-card border-b border-slate-800/80 px-6 py-4">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            <a href="#" class="text-xl sm:text-2xl font-bold tracking-wider text-gradient flex items-center gap-2">
                <i class="fa-solid fa-brain text-teal-400"></i> Safaa Salaheldin
            </a>

            <!-- Desktop Links -->
            <div class="hidden md:flex items-center space-x-8 font-medium text-sm text-slate-300">
                <a href="#about" class="hover:text-teal-400 transition-colors">About</a>
                <a href="#education" class="hover:text-teal-400 transition-colors">Education</a>
                <a href="#skills" class="hover:text-teal-400 transition-colors">Skills</a>
                <a href="#services" class="hover:text-teal-400 transition-colors">Services</a>
                <a href="#projects" class="hover:text-teal-400 transition-colors">Projects</a>
                <a href="#achievements" class="hover:text-teal-400 transition-colors">Achievements</a>
                <a href="#contact" class="hover:text-teal-400 transition-colors">Contact</a>
            </div>

            <!-- Mobile Menu Trigger -->
            <button id="mobileMenuBtn" class="md:hidden text-2xl text-slate-300 focus:outline-none" aria-label="Toggle Navigation">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>

        <!-- Mobile Drawer -->
        <div id="mobileMenu" class="hidden md:hidden mt-4 pb-4 border-t border-slate-800 flex flex-col space-y-3 px-2 pt-3 text-sm">
            <a href="#about" class="hover:text-teal-400 transition-colors py-1">About</a>
            <a href="#education" class="hover:text-teal-400 transition-colors py-1">Education</a>
            <a href="#skills" class="hover:text-teal-400 transition-colors py-1">Skills</a>
            <a href="#services" class="hover:text-teal-400 transition-colors py-1">Services</a>
            <a href="#projects" class="hover:text-teal-400 transition-colors py-1">Projects</a>
            <a href="#achievements" class="hover:text-teal-400 transition-colors py-1">Achievements</a>
            <a href="#contact" class="hover:text-teal-400 transition-colors py-1">Contact</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="min-h-screen pt-32 pb-20 px-6 flex items-center justify-center relative">
        <!-- Glowing background blobs -->
        <div class="absolute -top-40 -right-40 w-96 h-96 bg-teal-500/10 rounded-full filter blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-amber-500/10 rounded-full filter blur-3xl pointer-events-none"></div>

        <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            
            <!-- Hero Bio Content -->
            <div class="space-y-6 text-center lg:text-left">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-teal-500/10 border border-teal-500/20 text-teal-400 text-xs sm:text-sm font-semibold">
                    <span class="w-2 h-2 rounded-full bg-teal-400 animate-ping"></span>
                    AI Student & Data Science Enthusiast
                </div>

                <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-tight">
                    Hi, I'm <span class="text-gradient">Safaa Salaheldin</span>
                </h1>

                <p class="text-slate-400 text-base sm:text-lg max-w-2xl leading-relaxed">
                    Passionate about leveraging <strong class="text-slate-200">Data Science</strong>, <strong class="text-slate-200">Machine Learning</strong>, and <strong class="text-slate-200">Cyber Security</strong> to explore complex datasets and construct meaningful real-world solutions.
                </p>

                <div class="flex flex-wrap gap-4 justify-center lg:justify-start pt-2">
                    <a href="#projects" class="px-7 py-3.5 rounded-xl bg-gradient-to-r from-teal-500 to-emerald-500 hover:from-teal-600 hover:to-emerald-600 text-slate-950 font-bold shadow-lg shadow-teal-500/20 transition-all hover:scale-105 flex items-center gap-2">
                        <i class="fa-solid fa-code"></i> View My Projects
                    </a>
                    <a href="#contact" class="px-7 py-3.5 rounded-xl glass-card hover:bg-slate-800 text-slate-200 font-semibold border border-slate-700 transition-all hover:scale-105 flex items-center gap-2">
                        <i class="fa-regular fa-paper-plane"></i> Get in Touch
                    </a>
                </div>

                <!-- Quick Contact Links -->
                <div class="flex items-center justify-center lg:justify-start gap-6 pt-4 text-slate-400">
                    <a href="https://www.linkedin.com/in/safaa-salaheldin-051893376/" target="_blank" rel="noopener noreferrer" class="hover:text-teal-400 text-2xl transition-colors" title="LinkedIn Profile">
                        <i class="fa-brands fa-linkedin"></i>
                    </a>
                    <a href="mailto:Salahsafaa899@gmail.com" class="hover:text-teal-400 text-2xl transition-colors" title="Send Email">
                        <i class="fa-solid fa-envelope"></i>
                    </a>
                    <a href="tel:+201092663715" class="hover:text-teal-400 text-2xl transition-colors" title="Phone Call">
                        <i class="fa-solid fa-phone"></i>
                    </a>
                </div>
            </div>

            <!-- Profile Frame with Direct Upload Option -->
            <div class="flex flex-col items-center justify-center">
                <div class="relative w-72 h-72 sm:w-80 sm:h-80 md:w-96 md:h-96 rounded-3xl overflow-hidden glass-card p-3 border border-teal-500/30 glow-effect photo-upload-hover group cursor-pointer" id="avatarContainer">
                    
                    <!-- Displayed Image or Default Avatar SVG -->
                    <div class="w-full h-full rounded-2xl overflow-hidden relative bg-slate-800 flex items-center justify-center">
                        <img id="userAvatarImg" class="w-full h-full object-cover hidden" alt="Safaa Salaheldin Profile">
                        
                        <!-- Default Aesthetic Vector Placeholder -->
                        <div id="defaultAvatarSvg" class="w-full h-full flex flex-col items-center justify-center p-6 text-center bg-gradient-to-br from-slate-900 via-slate-800 to-teal-950">
                            <div class="w-28 h-28 rounded-full bg-teal-500/20 border-2 border-teal-400/40 flex items-center justify-center text-teal-300 text-5xl mb-4 shadow-inner">
                                <i class="fa-solid fa-user-astronaut"></i>
                            </div>
                            <h3 class="text-lg font-bold text-slate-200">Safaa Salaheldin</h3>
                            <p class="text-xs text-teal-400 font-medium mt-1">Data Science & AI</p>
                        </div>

                        <!-- Hover Upload Hint Overlay -->
                        <div class="upload-overlay absolute inset-0 bg-slate-950/80 backdrop-blur-sm opacity-0 transition-opacity duration-300 flex flex-col items-center justify-center p-4 text-center">
                            <i class="fa-solid fa-cloud-arrow-up text-4xl text-teal-400 mb-2 animate-bounce"></i>
                            <p class="text-sm font-semibold text-slate-100">Click to Upload Your Photo</p>
                            <p class="text-xs text-slate-400 mt-1">Loads instantly on your screen</p>
                        </div>
                    </div>

                    <!-- Hidden Input File -->
                    <input type="file" id="photoInput" accept="image/*" class="hidden">
                </div>

                <!-- Explicit Upload Button below photo -->
                <button id="uploadBtn" class="mt-4 px-4 py-2 rounded-lg bg-slate-800/80 hover:bg-slate-700 border border-slate-700 text-xs font-semibold text-teal-400 flex items-center gap-2 transition-colors shadow">
                    <i class="fa-solid fa-camera"></i> Upload Photo From Device
                </button>
            </div>
        </div>
    </section>

    <!-- About Me Section -->
    <section id="about" class="py-20 px-6 bg-slate-950/60 border-y border-slate-800/50">
        <div class="max-w-6xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">About <span class="text-teal-400">Me</span></h2>
                <div class="w-20 h-1 bg-gradient-to-r from-teal-500 to-amber-500 mx-auto rounded-full"></div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                <!-- Secondary Avatar Card in About Me -->
                <div class="lg:col-span-4 flex justify-center">
                    <div class="w-64 h-80 rounded-2xl overflow-hidden glass-card p-2 border border-teal-500/30 shadow-xl flex items-center justify-center relative bg-slate-900">
                        <img id="aboutAvatarImg" class="w-full h-full object-cover rounded-xl hidden" alt="Safaa Salaheldin">
                        <div id="aboutDefaultAvatar" class="w-full h-full rounded-xl bg-slate-800 flex flex-col items-center justify-center p-6 text-center">
                            <i class="fa-solid fa-user-graduate text-5xl text-teal-400 mb-4"></i>
                            <p class="text-sm font-bold text-slate-200">Safaa Salaheldin</p>
                            <p class="text-xs text-slate-400 mt-1">AI Student at ANU</p>
                        </div>
                    </div>
                </div>

                <!-- Text Bio -->
                <div class="lg:col-span-8 glass-card p-8 rounded-2xl space-y-6 border border-slate-800">
                    <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
                        Hi, I'm <strong class="text-teal-400">Safaa Salaheldin</strong>! I am an Artificial Intelligence student with a strong interest in <span class="text-slate-100 font-semibold">Data Science</span>, <span class="text-slate-100 font-semibold">Machine Learning</span>, and <span class="text-slate-100 font-semibold">Cyber Security</span>. I am actively refining my analytical and technical repertoire in Python, SQL, Data Analysis, and core problem solving.
                    </p>
                    <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
                        My passion for technology comes from my curiosity about how data can be used to understand problems, discover hidden patterns, and create useful, actionable solutions. I enjoy learning new technologies and applying what I learn through practical tasks and academic projects.
                    </p>
                    
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-4 border-t border-slate-800">
                        <div class="p-3 bg-slate-900/60 rounded-xl border border-slate-800">
                            <span class="block text-xl font-bold text-amber-400">3rd Year</span>
                            <span class="text-xs text-slate-400">AI Specialization</span>
                        </div>
                        <div class="p-3 bg-slate-900/60 rounded-xl border border-slate-800">
                            <span class="block text-xl font-bold text-teal-400">100%</span>
                            <span class="text-xs text-slate-400">Dedicated Learner</span>
                        </div>
                        <div class="p-3 bg-slate-900/60 rounded-xl border border-slate-800 col-span-2 sm:col-span-1">
                            <span class="block text-xl font-bold text-blue-400">Assiut</span>
                            <span class="text-xs text-slate-400">National University</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Education Section -->
    <section id="education" class="py-20 px-6">
        <div class="max-w-6xl mx-auto">
