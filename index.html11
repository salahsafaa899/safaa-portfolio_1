                <!-- Service 2 -->
                <div class="glass-card p-8 rounded-2xl border border-slate-800 hover:border-amber-500/50 transition-colors group">
                    <div class="w-14 h-14 bg-amber-500/10 rounded-2xl flex items-center justify-center text-amber-400 text-2xl mb-6 group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-server"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-100 mb-3">SQL Database Management</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        Designing database schemas, crafting optimized SQL queries, and maintaining relational databases efficiently.
                    </p>
