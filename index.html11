                        <i class="fa-solid fa-code"></i>
                    </div>
                    <h3 class="text-lg font-bold mb-3 text-slate-100">Programming</h3>
                    <ul class="space-y-2.5 text-slate-300 text-sm">
                        <li class="flex items-center justify-between"><span>Python</span> <span class="text-teal-400 font-semibold text-xs">Core</span></li>
                        <li class="flex items-center justify-between"><span>C++</span> <span class="text-slate-400 text-xs">OOP</span></li>
                        <li class="flex items-center justify-between"><span>Java</span> <span class="text-slate-400 text-xs">OOP</span></li>
                        <li class="flex items-center justify-between"><span>C#</span> <span class="text-slate-400 text-xs">Intermediate</span></li>
                    </ul>
                </div>

                <!-- Database & Data -->
                <div class="glass-card p-6 rounded-2xl border border-slate-800 hover:border-amber-500/40 transition-all hover:-translate-y-1">
                    <div class="w-12 h-12 bg-amber-500/10 rounded-xl flex items-center justify-center text-amber-400 text-xl mb-4">
                        <i class="fa-solid fa-database"></i>
                    </div>
                    <h3 class="text-lg font-bold mb-3 text-slate-100">Database & Data</h3>
                    <ul class="space-y-2.5 text-slate-300 text-sm">
                        <li class="flex items-center justify-between"><span>SQL</span> <span class="text-amber-400 font-semibold text-xs">Active</span></li>
                        <li class="flex items-center justify-between"><span>Data Analysis</span> <span class="text-slate-400 text-xs">Foundational</span></li>
                        <li class="flex items-center justify-between"><span>Data Science</span> <span class="text-slate-400 text-xs">Concepts</span></li>
                        <li class="flex items-center justify-between"><span>Web Scraping</span> <span class="text-slate-400 text-xs">Practical</span></li>
                    </ul>
                </div>

                <!-- Concepts -->
                <div class="glass-card p-6 rounded-2xl border border-slate-800 hover:border-teal-500/40 transition-all hover:-translate-y-1">
                    <div class="w-12 h-12 bg-teal-500/10 rounded-xl flex items-center justify-center text-teal-400 text-xl mb-4">
                        <i class="fa-solid fa-brain"></i>
                    </div>
                    <h3 class="text-lg font-bold mb-3 text-slate-100">Core Concepts</h3>
                    <ul class="space-y-2.5 text-slate-300 text-sm">
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-teal-400 text-xs"></i> Object-Oriented Prog.</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-teal-400 text-xs"></i> Problem Solving</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-teal-400 text-xs"></i> Machine Learning Intro</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-teal-400 text-xs"></i> Cyber Security Basics</li>
                    </ul>
                </div>

                <!-- Soft Skills -->
                <div class="glass-card p-6 rounded-2xl border border-slate-800 hover:border-amber-500/40 transition-all hover:-translate-y-1">
                    <div class="w-12 h-12 bg-amber-500/10 rounded-xl flex items-center justify-center text-amber-400 text-xl mb-4">
                        <i class="fa-solid fa-comments"></i>
