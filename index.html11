                            <input type="email" required placeholder="name@example.com" class="w-full px-4 py-3 bg-slate-900/80 rounded-xl border border-slate-700 text-slate-100 focus:outline-none focus:border-teal-400 transition-colors">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase text-slate-400 mb-2">Message</label>
