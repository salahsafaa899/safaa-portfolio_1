                        </div>
                        <button type="submit" class="w-full py-3.5 bg-gradient-to-r from-teal-500 to-emerald-500 text-slate-950 font-bold rounded-xl shadow-lg hover:from-teal-600 hover:to-emerald-600 transition-all flex items-center justify-center gap-2">
                            <i class="fa-solid fa-paper-plane"></i> Send Message
                        </button>
                    </form>
                    <div id="formFeedback" class="hidden mt-4 p-4 rounded-xl text-center text-sm font-semibold"></div>
